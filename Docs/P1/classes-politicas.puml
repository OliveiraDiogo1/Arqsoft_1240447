@startuml
title Políticas de empréstimo - modelo de classes

package "lendingmanagement.model.policy" {
  enum LendingPolicyType {
    STANDARD
    ADAPTIVE
  }

  interface LendingPolicy {
    +type(): LendingPolicyType
    +termsForNewLending(context: LendingPolicyContext): LendingTerms
    +termsForRenewal(context: LendingPolicyContext): LendingTerms
  }

  class StandardLendingPolicy
  class AdaptiveLendingPolicy

  class StandardPolicyConfig <<record>> {
    maxActiveLendings: int
    lendingPeriodDays: int
    maxRenewals: int
    renewalPeriodDays: int
  }

  class AdaptivePolicyConfig <<record>> {
    maxActiveLendings: int
    firstThreshold: int
    secondThreshold: int
    longPeriodDays: int
    standardPeriodDays: int
    shortPeriodDays: int
    maxRenewals: int
  }

  class LendingPolicyContext <<record>> {
    activeLendings: int
    hasOverdue: boolean
    renewalCount: int
  }

  class LendingTerms <<record>> {
    periodDays: int
  }

  class LendingHistory <<record>> {
    completedLendings: int
    onTimeLendings: int
    hasOverdue: boolean
    +onTimeRatioPercent(): double
  }

  class SelectionConfig <<record>> {
    historyPeriodMonths: int
    minCompletedLendings: int
    minOnTimeRatioPercent: double
  }

  interface LendingPolicySelectionRule {
    +select(history: LendingHistory): Optional<LendingPolicyType>
    +order(): int
  }

  class AdaptiveSelectionRule
  class StandardDefaultRule
  class LendingPolicySelector
  class LendingPolicyRegistry
}

StandardLendingPolicy ..|> LendingPolicy
AdaptiveLendingPolicy ..|> LendingPolicy
StandardLendingPolicy --> StandardPolicyConfig
AdaptiveLendingPolicy --> AdaptivePolicyConfig
LendingPolicy ..> LendingPolicyContext
LendingPolicy ..> LendingTerms
AdaptiveSelectionRule ..|> LendingPolicySelectionRule
StandardDefaultRule ..|> LendingPolicySelectionRule
AdaptiveSelectionRule --> SelectionConfig
LendingPolicySelector o-- LendingPolicySelectionRule
LendingPolicyRegistry o-- LendingPolicy
@enduml
